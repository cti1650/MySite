{
  "name": "nextjs-tailwindcss",
  "version": "1.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "audit": "npm audit",
    "secretlint": "secretlint --secretlintignore .gitignore \"**/*\"",
    "commitlint": "commitlint",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@mantine/core": "^9.5.2",
    "@mantine/form": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@mantine/notifications": "^9.5.2",
    "autoprefixer": "^10.4.0",
    "axios": "^1.18.0",
    "classcat": "5.0.3",
    "formidable": "^3.5.4",
    "mantine-form-zod-resolver": "^1.3.0",
    "next": "^16.3.3",
    "nodemailer": "^9.1.0",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^4.3.1",
    "sharp": "^0.35.0",
    "tailwindcss": "^3.0.24",
    "zod": "^4.4.3"
  },
  "license": "ISC",
  "keywords": [],
  "description": "Learn how to use Tailwind in a Next.js application,",
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/formidable": "^3.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "lefthook": "^2.1.14",
    "postcss": "^8.5.23",
    "secretlint": "^13.0.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "_overridesNote": "next が脆弱な postcss 8.4.31 を固定同梱するため、devDependencies の postcss ($postcss) に揃える。next 配下だけに絞り、他の依存の postcss 解決には干渉させない。旧 yarn resolutions の picomatch/nanoid/tailwindcss 系は上流が追従したため不要になった。",
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
