{
  "name": "nextjs-tailwindcss",
  "version": "1.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "audit": "npm audit",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@mantine/core": "^8.3.15",
    "@mantine/form": "^8.3.15",
    "@mantine/hooks": "^8.3.15",
    "@mantine/notifications": "^8.3.15",
    "autoprefixer": "^10.4.0",
    "axios": "^1.18.0",
    "classcat": "5.0.3",
    "formidable": "^3.5.4",
    "mantine-form-zod-resolver": "^1.3.0",
    "next": "^15.5.21",
    "nodemailer": "^9.1.0",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^4.3.1",
    "sharp": "^0.35.0",
    "tailwindcss": "^3.0.24",
    "zod": "^3.14.2"
  },
  "license": "ISC",
  "keywords": [],
  "description": "Learn how to use Tailwind in a Next.js application,",
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/formidable": "^3.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "postcss": "^8.5.23",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3"
  },
  "_overridesNote": "next が脆弱な postcss 8.4.31 を固定同梱するため、devDependencies の postcss ($postcss) に揃える。next 配下だけに絞り、他の依存の postcss 解決には干渉させない。旧 yarn resolutions の picomatch/nanoid/tailwindcss 系は上流が追従したため不要になった。",
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "npx biome check --staged --no-errors-on-unmatched --write"
  }
}
