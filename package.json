{
  "name": "nextjs-tailwindcss",
  "version": "1.0.0",
  "scripts": {
    "dev": "next",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "audit": "yarn audit",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@mantine/core": "^8.3.15",
    "@mantine/form": "^8.3.15",
    "@mantine/hooks": "^8.3.15",
    "@mantine/notifications": "^8.3.15",
    "autoprefixer": "^10.4.0",
    "axios": "^1.18.0",
    "classcat": "5.0.3",
    "formidable": "^3.5.4",
    "mantine-form-zod-resolver": "^1.3.0",
    "next": "^15.5.21",
    "nodemailer": "^9.1.0",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^4.3.1",
    "sharp": "^0.35.0",
    "tailwindcss": "^3.0.24",
    "zod": "^3.14.2"
  },
  "license": "ISC",
  "keywords": [],
  "description": "Learn how to use Tailwind in a Next.js application,",
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/formidable": "^3.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "postcss": "^8.5.23",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3"
  },
  "_resolutionsNote": "ビルド時のみ使う推移的依存の脆弱性解消。picomatchはv2系の利用元だけを指定する（tinyglobbyが必要とするv4系は当該CVEの影響外のため巻き込まない）",
  "resolutions": {
    "picomatch": "^2.3.2",
    "**/tinyglobby/picomatch": "^4.0.3",
    "**/next/postcss": "^8.5.23",
    "**/tailwindcss/postcss": "^8.5.23",
    "**/postcss/nanoid": "^3.3.18"
  },
  "simple-git-hooks": {
    "pre-commit": "npx biome check --staged --no-errors-on-unmatched --write"
  }
}
